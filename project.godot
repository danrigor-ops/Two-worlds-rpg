; Engine configuration file.
; Godot 4.4 or newer.

config_version=5

[application]

config/name="Two Worlds"
config/description="Prologue: The Great Escape. Godot 4 foundation with placeholder art."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
InputManager="*res://autoload/input_manager.gd"
Assets="*res://autoload/assets.gd"
Quests="*res://autoload/quests.gd"

[display]

window/size/viewport_width=240
window/size/viewport_height=160
window/size/window_width_override=960
window/size/window_height_override=640
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=0

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.15, 1)
